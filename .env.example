# Copiar a .env (nunca commitear .env real) — ver docs/context/api/stamless-api-v1.md

# URL base del API Stamless (sin /v1/{tenant_slug}, eso lo arma src/lib/api.ts).
# Local:      https://api.stamless.host
# Producción: https://api.stamless.io
STAMLESS_API_URL=https://api.stamless.host

# Slug del tenant — fijo para este proyecto (Cliente 0).
STAMLESS_TENANT_SLUG=cica360

# Token de BUILD TIME únicamente (ability content:read). Se usa solo dentro
# de src/lib/api.ts durante `astro build`/`astro dev` — nunca llega al
# bundle del cliente. Generar en Console -> Desarrolladores -> API Tokens.
# NUNCA commitear un valor real acá.
STAMLESS_API_TOKEN=

# Último recurso SOLO para desarrollo local: si STAMLESS_API_URL apunta a
# un dominio con certificado autofirmado no confiable (típico de MAMP
# PRO/Valet/Herd) y todavía no configuraste un certificado local confiable,
# poner STAMLESS_DEV_INSECURE_TLS=true desactiva la verificación TLS del
# build. Dejar SIEMPRE vacío/comentado por default — la solución correcta
# es mkcert (ver "TLS local con mkcert" en el README), no esta variable.
# STAMLESS_DEV_INSECURE_TLS=true

# URL pública final del sitio (usada por astro.config.mjs para `site`,
# sitemaps, canonical URLs, etc.).
PUBLIC_SITE_URL=https://cica360.com

STAMLESS_DEV_INSECURE_TLS=true

# Endpoint al que el componente ContactForm hace POST desde el navegador.
# Default recomendado: el proxy PHP servido junto al sitio estático.
# Si el hosting no soporta PHP, cambiar a la URL directa del API y usar
# PUBLIC_STAMLESS_FORMS_TOKEN (ver más abajo) — documentar la excepción.
PUBLIC_CONTACT_FORM_ENDPOINT=/contacto.php

# Fallback SOLO si no hay PHP disponible en el hosting: token acotado con
# ÚNICAMENTE la ability forms:submit (nunca content:read). Queda visible en
# el bundle del cliente a propósito — ver ADR-002 para el trade-off
# aceptado. Dejar vacío si se usa el proxy PHP (caso por defecto).
PUBLIC_STAMLESS_FORMS_TOKEN=

# --- Proxy PHP (contacto.php) — variables leídas server-side, no PUBLIC_* ---
# El script PHP no lee este .env directamente (PHP no interpreta .env de
# Node); estos valores se configuran aparte en `public/contacto.php` o en
# la config del hosting. Se documentan acá para que quede claro que deben
# coincidir con el token real generado en Console.
# STAMLESS_FORMS_PROXY_TOKEN=  (ability forms:submit, configurado en el PHP)
