---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada">
  <section class="mx-auto max-w-xl px-4 py-24 text-center">
    <h1 class="text-4xl font-bold">404</h1>
    <p class="mt-4 text-gray-600">La página que buscás no existe o fue movida.</p>
    <a href="/" class="mt-6 inline-block rounded bg-gray-900 px-6 py-3 font-medium text-white">Volver al inicio</a>
  </section>
</BaseLayout>
