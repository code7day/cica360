---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import { getPages, getPage, getSlider } from '../lib/api';

// La home se resuelve por `is_home = true` (no por slug fijo "home") para
// no asumir cuál page está marcada como home en Filament — es exactamente
// el mismo criterio que usa el backend (ver ADR-016 en el repo de
// Stamless). Si en el futuro cambia cuál page es la home, este código no
// necesita tocarse.
const { data: pages } = await getPages({ is_home: true, per_page: 1 });
const homeSummary = pages[0];

if (!homeSummary) {
  throw new Error(
    '[pages/index.astro] Ninguna página está marcada como is_home=true en el backend. ' +
      'Marcar una page como home en Console antes de buildear, o ajustar este fallback.',
  );
}

const page = await getPage(homeSummary.slug);

// Preload de la imagen principal del Hero (LCP) para acelerar el primer render
let preloadImage: string | null = null;
const heroBlock = page.blocks.find((b) => b.type === 'hero');
if (heroBlock) {
  const heroContent = heroBlock.content as { mode?: string; slider_slug?: string; background_image?: { url: string | null } } | undefined;
  if (heroContent?.mode === 'slider' && heroContent?.slider_slug) {
    const slider = await getSlider(heroContent.slider_slug).catch(() => null);
    const firstSlide = slider?.slides?.[0];
    preloadImage = firstSlide?.media?.image_desktop?.url ?? firstSlide?.media?.image_mobile?.url ?? null;
  } else if (heroContent?.background_image?.url) {
    preloadImage = heroContent.background_image.url;
  }
}
---

<BaseLayout
  title={page.title}
  description={page.meta?.seo_description}
  seoTitle={page.meta?.seo_title}
  keywords={page.meta?.seo_keywords}
  ogTitle={page.meta?.og_title}
  ogDescription={page.meta?.og_description}
  ogImage={page.meta?.og_image_rect ?? page.meta?.og_image_square}
  preloadImage={preloadImage}
>
  {page.blocks.map((block) => <BlockRenderer block={block} />)}
</BaseLayout>
