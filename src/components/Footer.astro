---
/**
 * Footer — scaffold funcional (sin diseño visual final, ver TASK.md Fase 2).
 * Mismo contrato que Header.astro: recibe el menú ya resuelto, sin fetch
 * propio (el fetch vive en BaseLayout.astro, ver ese archivo).
 *
 * El contenido "pesado" del pie de página (CTA, logos, etc.) YA NO se
 * resuelve acá ni con un fetch global fijo a un slug — ese mecanismo
 * (`getPage('footer-principal')` en BaseLayout.astro) fue REEMPLAZADO
 * (2026-09-01, pedido explícito del Tech Lead) por el bloque `footer` de
 * Filament: cada Página/Landing agrega ese bloque y elige a qué Content
 * tipo `Footer` se asocia (`content.footer_page_id`), y `BlockRenderer` lo
 * resuelve como un bloque más dentro de `page.blocks` (ver
 * `FooterBlock.astro`). Por eso ese contenido termina renderizado DENTRO
 * de `<main>` (como el resto de los bloques de la página), justo arriba de
 * este `<footer>`, que ahora vuelve a ser solo la nav + copyright fijos.
 */
import type { Menu } from '../lib/types';

interface Props {
  menu: Menu | null;
}

const { menu } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-gray-200">
  <div class="mx-auto max-w-6xl px-4 py-8 text-sm text-gray-600">
    {
      menu && (
        <nav aria-label="Enlaces del pie" class="mb-4">
          <ul class="flex flex-wrap gap-4">
            {menu.items.map((item) => (
              <li>
                <a href={item.href ?? '#'} target={item.target} class="hover:underline">
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <p>&copy; {year} CICA360. Todos los derechos reservados.</p>
  </div>
</footer>
