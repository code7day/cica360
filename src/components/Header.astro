      <div
        aria-hidden="true"
        class={`absolute inset-y-0 left-0 w-0 bg-cicaindigo-500 opacity-0 transition-all ${shapeDelay} duration-500 ${magneticEase} 3md:group-data-[scrolled=true]/nav:w-[max(200px,calc((100%-1200px)/2+200px))] 3md:group-data-[scrolled=true]/nav:opacity-100`}
