---
/** Stub funcional — bloque presentacional puro, sin JS. */
import type { Block } from '../../lib/types';

interface Props {
  block: Block;
}

const { block } = Astro.props;
const content = block.content as { media?: { url: string | null; alt_text: string | null } | null };
---

{
  content.media?.url && (
    <figure class="mx-auto max-w-4xl px-4 py-8">
      <img src={content.media.url} alt={content.media.alt_text ?? ''} class="w-full rounded" loading="lazy" />
      {block.title && <figcaption class="mt-2 text-sm text-gray-600">{block.title}</figcaption>}
    </figure>
  )
}
