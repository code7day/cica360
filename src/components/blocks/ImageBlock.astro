---
/**
 * Imagen única (`image`) — Stub funcional hasta 2026-09-11: solo
 * renderizaba `content.media` y usaba `block.title` a modo de caption
 * improvisado, sin consumir NINGUNA otra property ya declarada del lado
 * de Filament (`content.caption`/`aspect`/`align`,
 * `properties.background_type`/`background_color`/`padding_y`) — quedaban
 * "fantasma", sin efecto en el sitio.
 *
 * 2026-09-11 (pedido del Tech Lead: "el bloque imagen unica falta alinear
 * UX y con buenos copys y no deberia tener heading este bloque"): al
 * quitarle el `HeadingFieldset` en Filament (nunca se renderizaba acá como
 * encabezado real), se rewirea el bloque completo con su propio set de
 * campos: caption real (`content.caption`, ya no `block.title`), relación
 * de aspecto, alineación, fondo sólido/degradado (mismo
 * `resolveBackgroundStyle()` que el resto de bloques con fondo) y padding
 * vertical en 4 pasos.
 *
 * 2026-09-17: `properties.animation` (mencionado en versiones previas de
 * este comentario como "campo muerto") fue removido por completo de
 * Filament — ver ADR en genesis/docs/context/DECISIONS.md. La animación de
 * entrada al hacer scroll ahora es un mecanismo estático sitewide
 * (`data-reveal`, ver `global.css`/`BaseLayout.astro`), no configurable por
 * property. Este bloque no lo consume porque es una imagen suelta simple
 * sin necesidad de un efecto de entrada propio.
 */
import type { Block, Media } from '../../lib/types';
import { resolveBackgroundStyle, type BackgroundColorProperties } from '../../lib/background';

interface Props {
  block: Block;
}

const { block } = Astro.props;
const content = block.content as {
  media?: Media | null;
  caption?: string | null;
  aspect?: 'auto' | '16:9' | '4:3' | '1:1' | null;
  align?: 'left' | 'center' | 'right' | null;
};

interface ImageBlockProperties extends BackgroundColorProperties {
  padding_y?: 'sm' | 'md' | 'lg' | 'xl';
}

const properties = (block.properties as ImageBlockProperties) ?? {};
const sectionStyle = resolveBackgroundStyle(properties);

/** Mismos 4 pasos que el resto de los bloques (`RichText.astro`/`Cta.astro`). */
const PADDING_Y_CLASSES: Record<NonNullable<ImageBlockProperties['padding_y']>, string> = {
  sm: 'py-6 3md:py-8',
  md: 'py-8 3md:py-10',
  lg: 'py-10 3md:py-12',
  xl: 'py-14 3md:py-16',
};
const paddingYClass = PADDING_Y_CLASSES[properties.padding_y ?? 'md'];

const ASPECT_CLASSES: Record<NonNullable<typeof content.aspect>, string> = {
  auto: '',
  '16:9': 'aspect-video',
  '4:3': 'aspect-[4/3]',
  '1:1': 'aspect-square',
};
const aspectClass = ASPECT_CLASSES[content.aspect ?? 'auto'];

const ALIGN_CLASSES: Record<NonNullable<typeof content.align>, string> = {
  left: 'mr-auto',
  center: 'mx-auto',
  right: 'ml-auto',
};
const alignClass = ALIGN_CLASSES[content.align ?? 'center'];
---

{
  content.media?.url && (
    <section class="w-full" style={sectionStyle || undefined}>
      <figure class={`max-w-4xl px-4 ${paddingYClass} ${alignClass}`} data-reveal="fade">
        <img
          src={content.media.url}
          alt={content.media.alt_text ?? ''}
          width="1200"
          height="800"
          class={`w-full rounded object-cover ${aspectClass}`}
          loading="lazy"
        />
        {content.caption && <figcaption class="mt-2 text-sm text-gray-600">{content.caption}</figcaption>}
      </figure>
    </section>
  )
}
