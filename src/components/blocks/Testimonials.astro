---
/**
 * Testimonios / Casos de Éxito (`testimonials`) — implementación real
 * 2026-08-31, reemplaza el stub anterior. Mockup de referencia del Tech
 * Lead: sección de fondo sólido (teal en Cliente 0), grid de 3 tarjetas con
 * avatar circular, frase en itálica, nombre+puesto en itálica debajo, y un
 * único botón "Ver más" con ícono de ojo debajo de la grilla.
 *
 * **Actualización 2026-08-31 (misma tarde, corrección "expectativa vs
 * realidad" contra el mockup real del Tech Lead):**
 * - Avatares más grandes (antes `h-16 w-16` = 64px, ahora 96–112px).
 * - Cada testimonio pasa a vivir dentro de su propia tarjeta con fondo
 *   propio (`properties.item_background_color`, nuevo — ver
 *   `App\Filament\Schemas\PropertiesSchema` en genesis), no solo flotando
 *   sobre el fondo de la sección.
 * - La cita ya NO se envuelve en comillas por código — texto tal cual.
 * - Firma en una sola línea `— Nombre[, Rol]` (antes 2 líneas separadas,
 *   nombre arriba / rol abajo).
 * - Espaciados más generosos (gaps y padding de tarjeta), acorde al mockup.
 * - El subtítulo (`block.subtitle`) ya se renderizaba en código — el gap
 *   real era que el seeder (`Cliente0ContentSeeder`) no lo estaba
 *   sembrando en el bloque de la home; corregido del lado de genesis.
 * - **Carousel** (nuevo): si hay MÁS testimonios que los que caben en una
 *   fila (más de 3, el máximo de columnas en desktop — ver `MAX_GRID_ITEMS`
 *   abajo), la grilla estática se reemplaza por un carousel con scroll-snap
 *   horizontal nativo (swipe táctil de fábrica del navegador, sin JS extra
 *   para eso) + auto-avance por JS (mismo patrón vainilla ya usado en
 *   `Hero.astro`: pausa en hover/foco/touch, respeta
 *   `prefers-reduced-motion`) + puntos de navegación. Con 3 o menos
 *   testimonios se mantiene la grilla estática simple, sin JS.
 *
 * Dato clave del contrato de API (ver `ResolvesPublicLinks::transformBlockContent`
 * en genesis, rama `testimonials`): este bloque YA NO trae un filtro crudo
 * (`content.limit`/`content.order`) hasta acá — el backend lo resuelve en
 * runtime contra la tabla real `testimonials` (`is_visible = true`,
 * gestionada desde su propio recurso Filament) y entrega directamente
 * `content.items[]` ya recortado/ordenado (respeta el `limit`/`order`
 * propio de CADA bloque, confirmado en `ResolvesPublicLinks`), en la MISMA
 * forma que ya esperaba este componente (`name`/`role`/`quote`/`avatar`).
 *
 * `show_link`/`links[0]` (2026-08-31): mismo patrón "gate explícito" que
 * `rich_text` — un solo botón opcional ("Ver más casos de éxito"), nunca
 * un Repeater de enlaces. Ya apunta a la página interna real
 * (`Cliente0ContentSeeder::upsertHomePage()` linkea a `pages['casos-de-exito']`).
 */
import type { Block, ContentLink, Media } from '../../lib/types';
import { resolveBackgroundStyle, type BackgroundColorProperties } from '../../lib/background';
import { Icon } from 'astro-icon/components';
import BlockHeading from './BlockHeading.astro';

interface TestimonialItem {
  name?: string;
  role?: string | null;
  quote?: string;
  avatar?: Media | null;
}

interface Props {
  block: Block;
}

const { block } = Astro.props;

const content = block.content as { items?: TestimonialItem[]; background_image?: Media | null };
const items = content.items ?? [];

interface TestimonialsProperties extends BackgroundColorProperties {
  /** 2026-08-31, nuevo: fondo de CADA tarjeta, independiente del fondo de la sección. */
  item_background_color?: string | null;
  /** 2026-08-31, nuevo: % de opacidad del fondo de cada tarjeta en reposo (0–100). El hover sube +20 automáticamente, sin campo propio. */
  item_background_opacity?: number | null;
  text_color?: string | null;
  padding_y?: 'sm' | 'md' | 'lg' | 'xl';
  show_link?: boolean;
  /**
   * 2026-09-11 (pedido del Tech Lead: "todos deberian permitir personalizar
   * el fondo en 3 tipos") — imagen de fondo de la SECCIÓN (opcional, capa
   * intermedia sobre `background_color`), mismo patrón que `Features.astro`.
   * De paso, `background_color` pasa a resolverse con el helper genérico
   * `resolveBackgroundStyle()` (antes `background-color` plano, sin soporte
   * real de degradado pese a que Filament ya ofrecía esa opción).
   */
  media_blend_mode?: 'normal' | 'multiply' | 'screen' | 'overlay' | 'darken' | 'lighten' | null;
  media_brightness?: number | null;
  media_opacity?: number | null;
  media_filter_saturate?: number | null;
  media_filter_grayscale?: number | null;
  media_filter_sepia?: number | null;
  media_filter_contrast?: number | null;
  media_filter_hue_rotate?: number | null;
  media_filter_blur?: number | null;
  overlay_opacity?: number | null;
}

const properties = (block.properties as TestimonialsProperties) ?? {};
const link: ContentLink | undefined = block.links?.[0];
const showLink = Boolean(properties.show_link) && Boolean(link?.href) && Boolean(link?.label);

const PADDING_Y_CLASSES: Record<NonNullable<TestimonialsProperties['padding_y']>, string> = {
  sm: 'py-10 3md:py-14',
  md: 'py-14 3md:py-20',
  // 80px (py-20) es el estándar del design system para el padding vertical
  // de sección a partir de `lg` (1080px) — valor tomado del dev-mode de
  // Figma. Por debajo de `lg` se achica de forma responsive (48px base).
  lg: 'py-12 lg:py-20',
  xl: 'py-20 3md:py-32',
};

const paddingYClass = PADDING_Y_CLASSES[properties.padding_y ?? 'lg'];

const sectionStyle = [resolveBackgroundStyle(properties), properties.text_color ? `color: ${properties.text_color};` : ''].join(' ').trim();

/** Mismos 6 filtros CSS + opacidad + blend mode que `Features.astro`/`Cta.astro` (`properties.media_*`, set genérico). */
function backgroundImageEffectStyle(props: TestimonialsProperties): string {
  const filters: string[] = [];
  if (props.media_brightness != null) filters.push(`brightness(${props.media_brightness}%)`);
  if (props.media_filter_saturate != null) filters.push(`saturate(${props.media_filter_saturate}%)`);
  if (props.media_filter_grayscale != null) filters.push(`grayscale(${props.media_filter_grayscale}%)`);
  if (props.media_filter_sepia != null) filters.push(`sepia(${props.media_filter_sepia}%)`);
  if (props.media_filter_contrast != null) filters.push(`contrast(${props.media_filter_contrast}%)`);
  if (props.media_filter_hue_rotate != null) filters.push(`hue-rotate(${props.media_filter_hue_rotate}deg)`);
  if (props.media_filter_blur != null) filters.push(`blur(${props.media_filter_blur}px)`);

  const opacity = (props.media_opacity ?? 100) / 100;
  const blendMode = props.media_blend_mode ?? 'normal';

  return `${filters.length > 0 ? `filter: ${filters.join(' ')};` : ''} opacity: ${opacity}; mix-blend-mode: ${blendMode};`;
}
const backgroundImageStyle = backgroundImageEffectStyle(properties);
const overlayOpacity = Math.min(100, Math.max(0, properties.overlay_opacity ?? 0));

/**
 * 2026-08-31, pedido del Tech Lead: el fondo de cada tarjeta no es opaco —
 * el color elegido (`item_background_color`) se mezcla con transparencia,
 * ahora configurable desde Studio (`properties.item_background_opacity`,
 * 30% por defecto) en vez de un valor fijo en código. El hover sube +20
 * puntos automáticamente (tope 100%), sin un campo propio para eso. Los
 * porcentajes se pasan como custom properties (`--item-bg-opacity`/
 * `--item-bg-hover-opacity`) y la mezcla real ocurre en el `<style>`
 * scoped de abajo vía `color-mix()`, porque un hover real necesita CSS de
 * verdad — un `style` inline no puede expresar un pseudo-selector `:hover`.
 */
const itemBackgroundOpacity = Math.min(100, Math.max(0, properties.item_background_opacity ?? 30));
const itemBackgroundHoverOpacity = Math.min(100, itemBackgroundOpacity + 20);

const cardStyle = properties.item_background_color
  ? `--item-bg: ${properties.item_background_color}; --item-bg-opacity: ${itemBackgroundOpacity}%; --item-bg-hover-opacity: ${itemBackgroundHoverOpacity}%;`
  : '';

/** Iniciales como fallback de avatar (sin foto real cargada). */
function initials(name?: string): string {
  if (!name) return '';
  return name
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase())
    .join('');
}

/**
 * 2026-08-31, pedido del Tech Lead (calzar con el mockup real, "Nombre
 * R."): nombre corto para la firma — el primer nombre completo + la
 * inicial de la siguiente palabra (segundo nombre o apellido, no importa
 * cuál sea — el dato es un string libre `name`, no hay campos separados
 * de nombre/apellido). "María Fernanda Silva" → "María F.". Con un solo
 * nombre (sin espacios) se muestra tal cual, sin inicial.
 */
function shortName(name?: string): string {
  if (!name) return '';
  const parts = name.trim().split(/\s+/).filter(Boolean);
  if (parts.length <= 1) return parts[0] ?? '';

  return `${parts[0]} ${parts[1][0]!.toUpperCase()}.`;
}

// Máximo de columnas en desktop (ver `sm:grid-cols-2 lg:grid-cols-3` más
// abajo — 1 columna por default/<540px, 2 desde `sm`/540px, 3 desde
// `lg`/1080px; spec final del Tech Lead 2026-09-02, "mejor considerar:
// menor a 539px deberia ser de 1 en 1, apartir de 540px (sm) deberian de 2
// en 2 y de 1080px (lg) a más 3 en 3 y todo horizontal" — reemplaza un
// intento previo el mismo día que saltaba directo de 1 a 3 en `3md`/960px
// sin paso intermedio). Con más testimonios que esto, no entran todos en
// una sola fila → carousel en vez de grilla estática.
const MAX_GRID_ITEMS = 3;
const useCarousel = items.length > MAX_GRID_ITEMS;

/**
 * 2026-09-08 (15va vuelta): en `sm`–`lg` (540–1079px, 2 tarjetas por
 * página, `itemsPerView` SIEMPRE 2 ahí por diseño — ver `sm:basis-*` más
 * abajo) el Tech Lead reportó, con 3 capturas: en la 1ra página (item[0]+
 * item[1]) falta margen a la DERECHA de item[1] (el borde derecho de ESE
 * par, no del track); en la ÚLTIMA página falta margen a la IZQUIERDA del
 * primer item de ESE par. Las páginas intermedias están bien tal cual —
 * solo hace falta resolver los bordes de la 1ra/última página.
 *
 * **22va vuelta — fix real, SIN margen en el primer item de la última
 * página**: las vueltas 15–21 intentaron resolver el hueco IZQUIERDO de
 * la última página con `margin-left` en su primer item (`ml-5`, luego
 * `snap-start`, luego `scroll-margin-left`, luego corrigiendo a qué
 * índice se le aplicaba) — el Tech Lead confirmó con una captura que el
 * hueco seguía apareciendo ENTRE el penúltimo y el último item, no antes
 * del penúltimo ("has pasado lo mismo ml-5 al penúltimo... no entiendo").
 * Causa de fondo: `margin-left` en un item que NO es el primero del
 * track (hay contenido real antes) nunca se sostiene — el navegador
 * corrige el scroll hacia el snap-point de CADA tarjeta individual
 * (`scroll-snap-type: x mandatory` + `snap-center` en todas), sin
 * importar cuán preciso sea el cálculo del destino en JS ni qué
 * combinación de `scroll-margin`/`snap-align` se use en ese item puntual.
 *
 * Fix real: se abandona el margen por completo y se aplica el MISMO
 * truco ya confirmado para `item[1]` (16va vuelta, "ahora sí se ve genial
 * al inicio") — reducir el ANCHO del item que necesita ceder espacio,
 * nunca su margen. Para `item[1]` ese espacio es a su propia DERECHA (su
 * propio hueco). Para el ÚLTIMO item real, es análogo: el `pr-5` del
 * track (fijo, 20px, siempre al final del contenido scrolleable) más el
 * ancho estándar de 2 tarjetas llenan EXACTO el viewport en `sm`–`lg`
 * (identidad usada por `measureItemsPerView()` para medir 2 por vista) —
 * agregar el `pr-5` de más sin ceder ancho hace que el navegador, en el
 * límite físico de scroll, deba CORTAR 20px del lado IZQUIERDO del
 * penúltimo item para que todo entre. Dándole al ÚLTIMO item real la
 * MISMA reducción extra de ancho que `item[1]` (`calc(50%-30px)` en vez
 * de `calc(50%-10px)`), la cuenta cierra exacta: penúltimo (ancho
 * estándar) + gap + último (reducido) + `pr-5` = 100% del viewport — el
 * penúltimo queda flush a la izquierda SIN necesitar ningún margen,
 * override de snap, ni matemática de scroll aparte del clamp físico ya
 * existente (20va vuelta, `scrollWidth - clientWidth` para la última
 * página). Ver el nuevo condicional en `items.map` (`index === 1 ||
 * index === items.length - 1`) — ya no hace falta calcular ni distinguir
 * "el primer item de la última página" para nada (la vieja constante
 * `lastPageFirstRealIndex` se elimina, sin uso).
 */

/**
 * Carousel por PÁGINA, con `itemsPorVista` MEDIDO en runtime — no fijo en
 * build time (2026-09-02, 3ra vuelta, mismo día). Historial de los 2
 * intentos previos que este reemplaza:
 * - 2026-09-01: páginas fijas de `MAX_GRID_ITEMS` (3) armadas en build
 *   time con ventana circular (`items[(p*3+i) % items.length]`), cada
 *   "slide" del track era un `<div>` con su propio grid interno de hasta 3
 *   tarjetas (`testimonialPages`, ya no existe).
 * - 2026-09-02, corrección: se conectó ese diseño al markup (antes solo
 *   estaba documentado, el JSX seguía usando `items.map()` por testimonio).
 * - 2026-09-02, pedido del Tech Lead sobre una captura en ~978px de ancho
 *   ("pero esta mal, te pedi un item de 1 en 1, de 2 en 2 y 3 en 3 items,
 *   se ve muy mal por columnas"): con una página FIJA de 3 tarjetas
 *   dentro de un grid `sm:grid-cols-2 lg:grid-cols-3`, en el rango 540–
 *   1079px (2 columnas) la 3ra tarjeta de cada página quedaba sola en una
 *   fila nueva, con la mitad del ancho vacía — "por columnas" en vez de
 *   "por vista". El tamaño de página tiene que IGUALAR la cantidad de
 *   columnas activa (1/2/3), no quedar fijo en 3.
 *
 * Mismo patrón ya resuelto para `Logos.astro` el mismo día (ver ese
 * archivo para el detalle completo): el track deja de ser páginas
 * pre-armadas y pasa a ser scroll nativo ITEM POR ITEM, con cada tarjeta
 * midiendo su ancho vía `basis-*` responsive (ver `lg:basis-[calc(33.333%-
 * 1.334rem)]` más abajo, mismo breakpoint que el grid estático de arriba —
 * la resta de esa fórmula es la mitad del gap real de `lg` entre 3
 * tarjetas). El script mide en runtime cuántas tarjetas entran a la vez
 * (`itemsPerView`) comparando el ancho real de la primera tarjeta contra
 * el ancho del track, y arma `Math.ceil(items.length / itemsPerView)`
 * páginas/dots.
 *
 * **REMOVIDO 2026-09-08 (19na vuelta)**: hasta acá, el carousel clonaba las
 * primeras tarjetas reales y las pegaba al final del track (ocultas,
 * `aria-hidden`) para que la última página incompleta se autocompletara
 * "en vez de dejar un hueco", y el scroll/auto-avance daba la vuelta
 * infinita (`page % totalPages`, wraparound real). El Tech Lead reportó
 * "corrige... la cantidad configurada en el admin (5) pero me estás
 * devolviendo 5" — no era un problema de cantidad (el backend/API sí
 * respeta `content.limit`, confirmado); era que, al seguir scrolleando
 * después del último testimonio real, el wraparound mostraba de nuevo los
 * primeros — percibido como "se duplica y se vuelve infinito". Pedido
 * explícito: quitar el loop, que el carousel se detenga en el último
 * testimonio real. Se remueve la clonación completa (ver `<script>`, ya
 * no hay `cloneCount`/`clones`) y la navegación pasa de wraparound
 * (`% totalPages`) a CLAMP (`Math.min(page, totalPages - 1)`) — el
 * auto-avance se detiene solo al llegar a la última página, no vuelve a
 * la primera. La última página, si queda con menos testimonios que
 * `itemsPerView`, simplemente se ve con ese hueco real (menos tarjetas),
 * en vez de autocompletarse con duplicados.
 *
 * **Intento 2026-09-08 (11va/12va vuelta) — REVERTIDO en la 13va**: sobre
 * 2 mensajes ambiguos del Tech Lead ("deberian verse... 1 con la mitad de
 * relleno del siguiente testimonio", luego "falta centrar mejor y pasar
 * de 1 en 1 al centro") se interpretó un pedido de rediseño del rango
 * `sm`–`lg` (540–1079px) de "2 tarjetas completas" a "1 activa + peek de
 * la siguiente" (`Math.floor` en `measureItemsPerView()`, `sm:px-[25%]`
 * en el track). El resultado se rompió en vivo (captura con ~5 tarjetas
 * angostas amontonadas) y el Tech Lead lo confirmó tajante: "se pudrio
 * todo, te confundiste... tiene que ser de 2 en 2 y centrados" — el spec
 * SIGUE siendo el original de 2026-09-02 ("1 en 1, de 2 en 2 y 3 en 3"),
 * sin cambios. Revertido por completo a la 10ma vuelta.
 */
---

<section class="relative w-full" style={sectionStyle || undefined}>
  {
    content.background_image?.url && (
      <div class="pointer-events-none absolute inset-0" style={backgroundImageStyle}>
        <img src={content.background_image.url} alt="" width="1920" height="1080" class="h-full w-full object-cover" loading="lazy" />
      </div>
    )
  }
  {overlayOpacity > 0 && <div class="pointer-events-none absolute inset-0 bg-black" style={`opacity: ${overlayOpacity / 100};`} />}

  {/*
    2026-09-07, pedido del Tech Lead (3ra vuelta sobre este bloque): "que sea
    fullwidth solo menor a 1080px en esta seccion" — refiriéndose al
    contenedor padre completo (heading + carousel + botón "Ver más"), no solo
    al wrapper del carousel ya tratado arriba.

    CORRECCIÓN 2026-09-08 (8va vuelta, el Tech Lead encontró la causa él
    mismo): "el container de la section se cambio a px-0, pero que menores a
    540px se regrese el px-5" — por debajo de `sm`/540px (donde el carousel
    muestra 1 sola tarjeta a la vez) el contenedor SÍ vuelve a tener su
    padding propio de 20px (`px-5`); el fullwidth real de este contenedor
    queda acotado a `sm`–`lg` (540–1079px, donde se ven 2 tarjetas con peek).
    El heading y el botón mantienen su propio inset condicional
    (`sm:px-5 lg:px-0` abajo — SOLO en ese mismo rango intermedio, ya no en
    `base`, porque ahí el padding vuelve a salir de acá) para no pegarse al
    borde real ni duplicar el padding.
  */}
  <div class={`mx-auto flex max-w-6xl flex-col items-center gap-12 px-5 sm:px-0 lg:px-8 ${paddingYClass}`}>
    {
      /* CORRECCIÓN 2026-09-10: markup movido a `BlockHeading.astro` (partial
       * compartido — "todos los headings deberian ser... un solo partial
       * component reutilizado"). Único cambio real de comportamiento en
       * este bloque específico: pretitle/subtítulo dejan de usar
       * `opacity-80`/`opacity-90` — el Tech Lead pidió manejar color
       * explícito, no opacidad ("mejor se maneja con color... y si no se
       * configuró igual estamos en problemas"). Este bloque tiene fondo
       * SÓLIDO configurable por instancia (`properties.background_color`,
       * ej. `#206576` en los 3 usos sembrados hoy) + `text_color` explícito
       * (`#ffffff` en esos mismos 3 casos) que ya cascadea a los 3 campos
       * vía `style` del `<section>` — forzar acá los MISMOS colores de
       * marca que usan RichText/Features (`text-cicaindigo-500`, un tono
       * oscuro) rompería el contraste sobre ese fondo oscuro. Por eso NO
       * se pasa ningún `*ColorClass`: los 3 campos heredan el color
       * ambiente de la sección (antes solo lo hacía el título; ahora
       * pretitle/subtítulo también, a full opacidad, sin el matiz más tenue
       * que daba la opacidad — si se quiere ese matiz de vuelta, tendría
       * que ser un color explícito distinto por prop, no opacidad). */
    }
    <BlockHeading
      pretitle={block.pretitle}
      title={block.title}
      subtitle={block.subtitle}
      wrapperClass="flex w-full flex-col items-center gap-1 text-center sm:px-5 lg:px-0"
    />

    {
      items.length > 0 && !useCarousel && (
        <div class="grid w-full gap-8 sm:grid-cols-2 sm:px-5 lg:grid-cols-3 lg:px-0">
          {items.map((item, index) => (
            <blockquote
              class="testimonial-card flex flex-col items-center gap-6 rounded-2xl p-8 text-center transition-colors sm:p-10 2lg:p-6 xl:p-10"
              style={`${cardStyle} --reveal-delay: ${(index % 3) * 90}ms;`}
              data-reveal="up"
            >
              {item.avatar?.url ? (
                <img
                  src={item.avatar.url}
                  alt={item.avatar.alt_text ?? item.name ?? ''}
                  width="112"
                  height="112"
                  class="h-24 w-24 rounded-full object-cover sm:h-28 sm:w-28 2lg:h-20 2lg:w-20 xl:h-28 xl:w-28"
                  loading="lazy"
                />
              ) : (
                <span class="flex h-24 w-24 items-center justify-center rounded-full bg-white/15 text-xl font-bold sm:h-28 sm:w-28 2lg:h-20 2lg:w-20 xl:h-28 xl:w-28" aria-hidden="true">
                  {initials(item.name)}
                </span>
              )}
              <p class="text-base italic opacity-95">{item.quote}</p>
              <footer class="flex flex-col items-center gap-1">
                <p class="font-semibold italic">— {shortName(item.name)}</p>
                {item.role && <p class="text-sm italic opacity-80">{item.role}</p>}
              </footer>
            </blockquote>
          ))}
        </div>
      )
    }

    {
      items.length > 0 && useCarousel && (
        // `mx-0` (2026-09-08, 8va vuelta — el Tech Lead encontró la causa
        // él mismo: "ya encontre el container de la section se cambio a
        // px-0, pero que menores a 540px se regrese el px-5, entonces el
        // wrapper del carousel seguía con `-mx-4 sm:-mx-6 lg:mx-0` sera
        // mejor que regrese a mx-0"). Historial: este wrapper usaba
        // `-mx-4 sm:-mx-6 lg:mx-0`, un margen negativo pensado para
        // CANCELAR el padding que el contenedor padre tenía en su momento
        // (`px-4 sm:px-6 lg:px-8`). En la 3ra vuelta (mismo día, "que sea
        // fullwidth solo menor a 1080px en esta seccion") el padding del
        // PADRE pasó a `px-0`/`sm:px-0` por debajo de `lg` — pero este
        // `-mx-4 sm:-mx-6` se quedó sin actualizar, cancelando un padding
        // que ya no existía ahí: el resultado era un margen negativo real
        // (no una cancelación), wrapper más ancho que el propio viewport.
        // Ahora, con la 8va vuelta, el padre vuelve a tener `px-5` por
        // debajo de `sm`/540px (ver comentario de arriba) — así que YA NO
        // hace falta ningún margen, ni positivo ni negativo: `mx-0` a
        // secas. Por debajo de `sm`, el wrapper hereda el `px-5` del
        // padre (inset de 20px, ya NO edge-to-edge — corrección explícita
        // de esta vuelta); entre `sm` y `lg` el padre no tiene padding
        // propio, así que el wrapper sigue edge-to-edge de verdad; en
        // `lg`+, dentro del padding compartido del padre (grid de
        // escritorio).
        <div class="mx-0 w-full" data-testimonials-carousel>
          {
            /*
             * SIN padding propio en el track (corrección, mismo día): "al
             * centrar uno siempre al centro, se muestra el anterior
             * elemento una parte de relleno y el siguiente elemento una
             * parte de relleno tambien... tanto el siguiente como el
             * anterior deben pegarse a los extremos como parte de la
             * ventana o viewport" — con `snap-center`, la tarjeta activa
             * SIEMPRE deja asomar un "relleno" (peek) de la anterior y la
             * siguiente a los costados (es la naturaleza de centrar algo
             * más angosto que el viewport) — el `px-5` de la vuelta previa
             * metía un gutter EXTRA entre ese peek y el borde real de la
             * pantalla, cuando el pedido es que el peek mismo llegue justo
             * hasta el borde, sin nada en el medio. El breakout del
             * wrapper (`-mx-4 sm:-mx-6 lg:mx-0`, ver arriba) sigue
             * haciendo falta igual — sin eso, el padding del contenedor
             * PADRE (heading/botón) seguiría dejando ese mismo gutter no
             * deseado.
             * `sm:gap-5` (2026-09-08, 14va vuelta: "aumentaremos el
             * espacio entre ellos (gap) podria ser un 20px" — sube desde
             * los 10px de la 9na vuelta) — SOLO en el rango de 2 tarjetas
             * por vista (`sm`–`lg`, 540–1079px); `gap-5` = 1.25rem = 20px
             * exacto en la escala de Tailwind. `gap-8` (32px) se mantiene
             * en `base` (1 tarjeta) y vuelve explícito en `lg` (grid de 3
             * columnas de escritorio).
             *
             * REVERTIDO (2026-09-08, 13va vuelta): la 11va/12va vuelta
             * había cambiado esto a "1 tarjeta activa + peek de la
             * siguiente" (`sm:px-[25%]`, `Math.floor` en
             * `measureItemsPerView()`) interpretando 2 mensajes ambiguos
             * del Tech Lead como un pedido de rediseño — el resultado se
             * rompió en vivo (captura con ~5 tarjetas angostas amontonadas,
             * nada centrado) y el Tech Lead lo confirmó tajante: "se
             * pudrio todo, te confundiste... tiene que ser de 2 en 2 y
             * centrados". Se vuelve exactamente al estado de la 10ma
             * vuelta: sin padding propio en el track (el `pr-5` de abajo
             * es el único), sin `Math.floor` (ver `measureItemsPerView()`
             * más abajo, vuelve a `Math.round`).
             */
          }
          <div
            class="testimonials-track flex snap-x snap-mandatory gap-8 overflow-x-auto scroll-smooth pr-5 pb-2 sm:gap-5 lg:gap-8"
            data-testimonials-track
          >
            {items.map((item, index) => (
              <>
                {
                  /*
                   * 2026-09-07 (5ta vuelta, fix real): el `mr-6` (luego
                   * `mr-5`, ver 6ta vuelta abajo) en el ÚLTIMO item real NO
                   * llegaba a mostrarse — el wraparound (más abajo,
                   * `cloneNode`) SIEMPRE agrega clones detrás del último item
                   * real cuando el carousel está activo (`isOverflowing`),
                   * así que ese último item real nunca es el último hijo
                   * real del track: su margen quedaba a mitad de camino,
                   * entre él y el primer clon, no en el borde verdadero
                   * donde termina el scroll. El `ml-*` del PRIMER item sí
                   * funciona porque nada se clona ANTES — ese borde es
                   * estable. Fix: el margen inicial sigue siendo margen de
                   * item (borde estable), pero el margen final pasa a ser
                   * `padding-right` del track (ver `data-testimonials-track`
                   * arriba) — vive en el contenedor, así que aparece después
                   * de lo que sea que termine ocupando el último lugar del
                   * scroll (item real o clon), no atado a un hijo específico.
                   * Mismo principio ya documentado en este archivo/
                   * `Features.astro`: gutters de borde en el CONTENEDOR, no
                   * en márgenes de hijos.
                   *
                   * 2026-09-08 (6ta vuelta): `ml-6`/`pr-6` (24px) del pedido
                   * original ("para que pueda quedar estetico") bajan a
                   * `ml-5`/`pr-5` (20px) — captura de DevTools del Tech Lead
                   * sobre `Testimonials.astro`: "si te fijas en el area del
                   * bloque de cada testimonio, tiene una separacion o
                   * espacio al margen de la ventana, si lo comparamos con el
                   * pr-5 o mr-5 del contenido de los elementos de las otras
                   * secciones" — 20px (`*-5`) es el gutter estándar del
                   * resto del sitio (mismo valor ya usado en el carousel de
                   * `Features.astro` y en el "alineado al cuerpo de la
                   * página" de otras secciones); 24px (`*-6`) quedaba
                   * inconsistente.
                   *
                   * REVERTIDO (2026-09-08, 13va vuelta): la 11va/12va vuelta
                   * había puesto `ml-5 sm:ml-0 lg:ml-5` acá (parte del
                   * rediseño "1 activa + peek" que se revirtió por completo,
                   * ver comentario de `data-testimonials-track` arriba) — el
                   * Tech Lead confirmó que el diseño correcto sigue siendo
                   * el de la 6ta vuelta: `ml-5` fijo en las 3 rangos, sin
                   * condicionales por breakpoint.
                   *
                   * Fix real para item[1] (borde derecho de la 1ra página),
                   * CONFIRMADO en vivo ("ahora sí se ve genial al inicio",
                   * 16va vuelta): en vez de margen, se ACHICA su propio
                   * ancho 20px extra (`calc(50%-30px)` en vez de
                   * `calc(50%-10px)`) — a `scrollLeft: 0` (posición fija) el
                   * hueco que deja un ancho más chico es real y visible, no
                   * se lo "come" ningún hermano posterior.
                   *
                   * El primer item de la ÚLTIMA página (el "penúltimo" real)
                   * pasó por 6 intentos fallidos seguidos (15va–21va vuelta:
                   * margen simple → offset en JS → `snap-start` →
                   * `scroll-margin-left` → clamp al límite físico de scroll
                   * → corrección del índice) — el Tech Lead confirmó con una
                   * captura que el hueco seguía apareciendo ENTRE el
                   * penúltimo y el último item (nunca antes del penúltimo),
                   * sin importar cuán preciso fuera el destino de scroll ni
                   * qué combinación de propiedades de snap se probara.
                   *
                   * Causa de fondo, recién identificada (22va vuelta):
                   * `margin-left` en un item que NO es el primero del track
                   * (hay contenido real antes de él) nunca se sostiene — el
                   * navegador corrige el scroll hacia el snap-point de CADA
                   * tarjeta individual, sin importar el cálculo. Fix real:
                   * se abandona el margen por completo. Mismo truco de
                   * `item[1]` (reducir ANCHO, nunca margen) pero aplicado al
                   * ÚLTIMO item real (`index === items.length - 1`) en vez
                   * del penúltimo — el `pr-5` del track (20px, fijo, al
                   * final de todo el contenido scrolleable) más 2 tarjetas
                   * de ancho estándar llenan EXACTO el viewport en esta
                   * vista (misma cuenta que usa `measureItemsPerView()`);
                   * sin ceder ancho en algún lado, el límite físico de
                   * scroll (`scrollWidth - clientWidth`, 20va vuelta) corta
                   * 20px del lado IZQUIERDO del penúltimo para que todo
                   * entre — exactamente el síntoma reportado. Dándole al
                   * ÚLTIMO real la misma reducción extra que `item[1]`
                   * (`calc(50%-30px)`), la cuenta cierra exacta: penúltimo
                   * (ancho estándar, SIN ninguna clase especial) + gap +
                   * último (reducido) + `pr-5` = 100% del viewport — el
                   * penúltimo queda flush a la izquierda sin margen, sin
                   * overrides de snap, nada.
                   */
                }
              <blockquote
                class={`testimonial-card flex shrink-0 basis-full snap-center flex-col items-center gap-6 rounded-2xl p-8 text-center transition-colors ${index === 1 || index === items.length - 1 ? 'sm:basis-[calc(50%-30px)]' : 'sm:basis-[calc(50%-10px)]'} sm:p-10 lg:basis-[calc(33.333%-1.334rem)] 2lg:p-6 xl:p-10 ${index === 0 ? 'ml-5' : ''}`}
                style={`${cardStyle} --reveal-delay: ${(index % 3) * 90}ms;`}
                data-testimonials-item
                data-reveal="up"
              >
                {item.avatar?.url ? (
                  <img
                    src={item.avatar.url}
                    alt={item.avatar.alt_text ?? item.name ?? ''}
                    width="112"
                    height="112"
                    class="h-24 w-24 rounded-full object-cover sm:h-28 sm:w-28 2lg:h-20 2lg:w-20 xl:h-28 xl:w-28"
                    loading="lazy"
                  />
                ) : (
                  <span class="flex h-24 w-24 items-center justify-center rounded-full bg-white/15 text-xl font-bold sm:h-28 sm:w-28 2lg:h-20 2lg:w-20 xl:h-28 xl:w-28" aria-hidden="true">
                    {initials(item.name)}
                  </span>
                )}
                <p class="text-base italic opacity-95">{item.quote}</p>
                <footer class="flex flex-col items-center gap-1">
                  <p class="font-semibold italic">— {shortName(item.name)}</p>
                  {item.role && <p class="text-sm italic opacity-80">{item.role}</p>}
                </footer>
              </blockquote>
              </>
            ))}
          </div>

          <div class="mt-6 flex w-full items-center justify-center" role="tablist" aria-label="Casos de éxito" data-testimonials-dots />
        </div>
      )
    }

    {
      showLink && link && (
        /* Hover: 2026-09-11 (pedido del Tech Lead, con captura de este
        botón sobre el fondo teal: "es white y no cambia a cicagold-500")
        — default `border-current`/texto heredado (`properties.text_color`
        del bloque, `#ffffff` en el contenido sembrado) → hover explícito
        a `cicagold-500` en borde Y texto (mismo criterio: botón OUTLINE
        sobre fondo de color → hover `cicagold-500`, distinto del caso
        "default cicaindigo sobre fondo claro" → hover `cicagold-600`).
        Antes: `hover:bg-white/10` (velo sutil, sin dorado). */
        <a
          href={link.href ?? '#'}
          target={link.target}
          rel={link.target === '_blank' ? 'noopener noreferrer' : undefined}
          class="hover:border-cicagold-500 hover:text-cicagold-500 mt-4 inline-flex h-12 items-center justify-center gap-2 rounded-lg border border-current px-8 text-sm font-bold tracking-[0.1em] uppercase transition sm:mx-5 lg:mx-0"
          data-reveal="up"
        >
          <Icon name="ph:eye" size={18} aria-hidden="true" />
          {link.label}
        </a>
      )
    }
  </div>
</section>

<style>
  /* Scroll-snap nativo ya da swipe táctil gratis — solo se oculta la
     scrollbar del track para que se vea como un carousel, no una lista con
     overflow visible. */
  .testimonials-track {
    scrollbar-width: none;
    -ms-overflow-style: none;
    /* 2026-08-31: el swipe horizontal lo maneja el drag handler de abajo
       (Pointer Events, funciona igual con touch/mouse/pen) — `pan-y` le
       dice al navegador que NO intente panear horizontal por su cuenta
       (evita pelear con el JS) pero SÍ deje pasar el scroll vertical
       normal de la página. */
    touch-action: pan-y;
    cursor: grab;
  }

  .testimonials-track::-webkit-scrollbar {
    display: none;
  }

  .testimonials-track.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }

  .testimonials-track.is-dragging .testimonial-card {
    pointer-events: none;
  }

  /* Fondo de cada tarjeta (2026-08-31, pedido del Tech Lead): no es el
     color elegido a máxima opacidad — se mezcla con transparente
     (`color-mix()`, funciona con cualquier formato de color que entregue
     el `ColorPicker`, no solo hex). El % en reposo/hover es configurable
     desde Studio (`--item-bg-opacity`/`--item-bg-hover-opacity`, ver
     `item_background_opacity` más arriba, default 30%/50%). Sin
     `--item-bg` seteado (bloque sin `item_background_color`) queda
     transparente en ambos estados, sin romper nada. */
  .testimonial-card {
    background-color: color-mix(in srgb, var(--item-bg, transparent) var(--item-bg-opacity, 30%), transparent);
  }

  .testimonial-card:hover,
  .testimonial-card:focus-within {
    background-color: color-mix(in srgb, var(--item-bg, transparent) var(--item-bg-hover-opacity, 50%), transparent);
  }
</style>

<script>
  // Carousel de testimonios, por PÁGINA con `itemsPerView` medido en
  // runtime (2026-09-02, 3ra vuelta — ver docblock del frontmatter para el
  // historial completo de los 2 intentos previos que esto reemplaza).
  // Mismo patrón vainilla ya resuelto para `Logos.astro` el mismo día
  // (ver ese archivo para el detalle línea por línea): drag con Pointer
  // Events (mouse+touch+pen), auto-avance con pausa en interacción,
  // respeta `prefers-reduced-motion`, `itemsPerView` medido comparando el
  // ancho real de la primera tarjeta contra el ancho del track (cambia
  // por breakpoint: 1/<540px, 2/540–1079px, 3/1080px+), dots reconstruidos
  // en runtime (`Math.ceil(items.length / itemsPerView)`, no uno por
  // testimonio), y wraparound de la última página incompleta clonando las
  // primeras tarjetas al final del track (ocultas, `aria-hidden`,
  // scrolleables) en vez de dejar un hueco.
  //
  // Diferencia real con `Logos.astro`: acá no hay flechas prev/next (nunca
  // las tuvo este bloque, solo dots + drag + auto-avance), y el intervalo
  // de auto-avance es más largo (5s, ya establecido desde 2026-08-31 —
  // tiene sentido leer un testimonio completo antes de que cambie).
  //
  // 2026-09-08 (19na vuelta): SIN wraparound — ya no se clonan tarjetas al
  // final del track. Ver docblock del frontmatter para el porqué (reporte
  // del Tech Lead: el loop infinito se percibía como testimonios
  // "duplicándose" más allá de la cantidad configurada en el admin). El
  // carousel ahora es de páginas REALES únicamente; la navegación hace
  // CLAMP en vez de dar la vuelta (ver `scrollToIndex`), y la última
  // página, si queda con menos tarjetas que `itemsPerView`, se ve tal cual
  // — sin autocompletar con duplicados.
  function initTestimonialsCarousels() {
    const roots = document.querySelectorAll('[data-testimonials-carousel]');

    roots.forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.testimonialsInitialized === 'true') return;
      root.dataset.testimonialsInitialized = 'true';

      const track = root.querySelector('[data-testimonials-track]');
      const realItems = Array.from(root.querySelectorAll('[data-testimonials-item]'));
      const dotsContainer = root.querySelector('[data-testimonials-dots]');

      if (!(track instanceof HTMLElement) || realItems.length <= 1) return;

      // `allItems` direcciona posiciones de scroll — sin wraparound (19na
      // vuelta), son directamente los testimonios reales, ninguna copia.
      const allItems = [...realItems];

      const intervalMs = 5000;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      let current = 0;
      let timer: number | undefined;
      let resumeTimer: number | undefined;
      // 2026-09-08 (23va vuelta): sincroniza el dot activo con la
      // posición REAL del scroll, sin importar cómo se movió (drag con
      // Pointer Events, swipe táctil nativo si el navegador lo toma antes
      // que nuestro handler, trackpad/wheel horizontal, flechas de
      // teclado con foco). Antes, el dot solo se actualizaba en 3 lugares
      // puntuales (click en un dot, `onPointerUp`, auto-avance) — un
      // swipe que el navegador maneja por su cuenta (o que termina en una
      // posición que `onPointerUp` no vio, ej. con momentum/inercia
      // después de soltar el dedo) dejaba el dot desactualizado, y el
      // auto-avance retomaba desde ese `current` viejo — "el indicador
      // dots no se actualiza... luego sigue su curso y marca otra cosa".
      let scrollSyncTimer: number | undefined;
      let isOverflowing = false;
      // Cuántos testimonios entran a la vez en el viewport actual —
      // medido en `updateOverflow()`, cambia por breakpoint.
      let itemsPerView = 1;
      // Cantidad de páginas = techo(testimonios reales / itemsPerView).
      let totalPages = 1;
      let dots: Element[] = [];

      // 2026-09-08 (20va vuelta): reemplaza el intento de las vueltas
      // 16–18 (offset de -20px en JS, luego `snap-start`, luego
      // `scroll-margin-left` — ninguno mostró el margen en vivo, "sigue
      // igual" según el Tech Lead). Ese enfoque calculaba un destino
      // "a mano" (`offsetLeft - 20px`) que casi nunca coincidía con el
      // límite real de scroll (sobraba el `pr-5` final, y antes de la 19na
      // vuelta también los clones del wraparound) — el navegador tenía
      // margen de sobra para "corregir" el scroll lejos de ese destino.
      //
      // Fix real: en vez de calcular un destino aproximado, para la
      // ÚLTIMA página se apunta directo al MÁXIMO scroll posible
      // (`scrollWidth - clientWidth`). Es un límite físico — no hay "más
      // allá" a donde el navegador pueda corregir, exactamente el mismo
      // principio por el que el `ml-5` del PRIMER item (página 0) siempre
      // funcionó sin ningún truco: `scrollLeft: 0` también es un límite
      // físico. Con esto, el `sm:ml-5` del primer item de la última
      // página y el `pr-5` final del track quedan dentro del viewport tal
      // cual están en el DOM — ya no hace falta `snap-start` ni
      // `scroll-margin-left` en ese item (ver `items.map`, clases
      // simplificadas de vuelta a solo `sm:ml-5 lg:ml-0`).
      function scrollToIndex(page: number) {
        const trackEl = track as HTMLElement;
        const next = Math.max(0, Math.min(page, totalPages - 1));
        const isLastPage = next === totalPages - 1;
        const left = isLastPage
          ? trackEl.scrollWidth - trackEl.clientWidth
          : (allItems[Math.min(next * itemsPerView, allItems.length - 1)] as HTMLElement).offsetLeft - trackEl.offsetLeft;
        trackEl.scrollTo({ left, behavior: 'smooth' });
        setActive(next);
      }

      function setActive(page: number) {
        current = page;
        dots.forEach((dot, dotIndex) => {
          dot.setAttribute('data-active', dotIndex === page ? 'true' : 'false');
          dot.setAttribute('aria-selected', dotIndex === page ? 'true' : 'false');
        });
      }

      function stop() {
        if (timer) window.clearInterval(timer);
        timer = undefined;
      }

      // 2026-09-08 (19na vuelta): el auto-avance se DETIENE al llegar a la
      // última página en vez de dar la vuelta a la primera (antes, con
      // wraparound, `scrollToIndex(current + 1)` + `% totalPages` producía
      // el loop infinito). Sin esto, con `scrollToIndex` ya clampeado
      // (ver arriba), el timer seguiría disparando cada 5s sin mover nada
      // — mejor cortar el intervalo apenas se llega al final.
      function start() {
        if (prefersReducedMotion || !isOverflowing) return;
        stop();
        timer = window.setInterval(() => {
          if (current >= totalPages - 1) {
            stop();
            return;
          }
          scrollToIndex(current + 1);
        }, intervalMs);
      }

      // Pausa el auto-avance mientras el usuario interactúa (drag/swipe,
      // hover, scroll con rueda/trackpad, foco por teclado) y lo retoma
      // un instante después de soltar — mismo criterio de accesibilidad
      // que `Hero.astro`.
      function pauseThenResume() {
        stop();
        if (resumeTimer) window.clearTimeout(resumeTimer);
        resumeTimer = window.setTimeout(start, 2500);
      }

      // 2026-09-08 (23va vuelta): en cada evento de scroll (venga de
      // donde venga: drag manual, swipe táctil nativo, trackpad/wheel,
      // momentum tras soltar el dedo, `scrollToIndex()` propio) se
      // reprograma un timeout corto — cuando el scroll deja de disparar
      // eventos por 120ms (heurística estándar de "scroll asentado"), se
      // sincroniza el dot activo con `nearestPage()`, la página REAL más
      // cercana a donde quedó el scroll. Separado de `pauseThenResume()`
      // (que sigue controlando el auto-avance) porque acá NO se llama a
      // `scrollToIndex()` — no se fuerza ningún re-snap, solo se pone al
      // día cuál dot está activo, sin pelear con la posición donde el
      // usuario/navegador ya asentó el scroll.
      function handleScrollSettled() {
        if (scrollSyncTimer) window.clearTimeout(scrollSyncTimer);
        scrollSyncTimer = window.setTimeout(() => setActive(nearestPage()), 120);
      }

      /** Busca la página cuyo item inicial está más cerca del scroll actual (0..totalPages-1). */
      function nearestPage(): number {
        const trackEl = track as HTMLElement;
        const targetLeft = trackEl.scrollLeft + trackEl.offsetLeft;
        // Mismo criterio de `scrollToIndex()` (20va vuelta): la última
        // página se compara contra el máximo físico de scroll, no contra
        // el `offsetLeft` de un item — así un drag/swipe soltado cerca del
        // final "elige" esa página con el mismo destino exacto que
        // produciría un click en su dot.
        const maxScrollLeftAsOffset = trackEl.scrollWidth - trackEl.clientWidth + trackEl.offsetLeft;

        let closest = 0;
        let closestDistance = Infinity;

        for (let page = 0; page < totalPages; page++) {
          const isLastPage = page === totalPages - 1;
          const pagePosition = isLastPage
            ? maxScrollLeftAsOffset
            : (allItems[Math.min(page * itemsPerView, allItems.length - 1)] as HTMLElement).offsetLeft;
          const distance = Math.abs(pagePosition - targetLeft);
          if (distance < closestDistance) {
            closestDistance = distance;
            closest = page;
          }
        }

        return closest;
      }

      /**
       * Mide cuántos testimonios REALES entran a la vez en el ancho
       * actual del track: ancho real de la primera tarjeta (todas miden
       * lo mismo dentro de un breakpoint, mismo `basis-*`) + el gap real
       * leído del CSS computado.
       */
      function measureItemsPerView(): number {
        const trackEl = track as HTMLElement;
        const firstItem = realItems[0] as HTMLElement;
        const itemWidth = firstItem.getBoundingClientRect().width;
        if (itemWidth <= 0) return 1;

        const trackStyle = window.getComputedStyle(trackEl);
        const gapPx = Number.parseFloat(trackStyle.columnGap || trackStyle.gap || '32') || 32;

        // REVERTIDO (2026-09-08, 13va vuelta): la 11va vuelta había
        // cambiado esto a `Math.floor`, parte del rediseño "1 activa +
        // peek" en el rango `sm`–`lg` — ese rediseño se revirtió por
        // completo (ver comentario de `data-testimonials-track`, el Tech
        // Lead confirmó "tiene que ser de 2 en 2 y centrados", no "1 en
        // 1"). Vuelve a `Math.round`: 2 tarjetas por página en ese rango,
        // como siempre fue desde la 9na/10ma vuelta.
        const measured = Math.round((trackEl.clientWidth + gapPx) / (itemWidth + gapPx));
        return Math.max(1, measured);
      }

      /** Reconstruye los puntos del DOM para que haya exactamente `count` — uno por PÁGINA, no por testimonio. */
      function buildDots(count: number) {
        if (!(dotsContainer instanceof HTMLElement)) return;

        dotsContainer.innerHTML = '';
        const built: HTMLButtonElement[] = [];

        for (let page = 0; page < count; page++) {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className =
            'group relative flex h-9 w-9 items-center justify-center cursor-pointer p-0 bg-transparent border-0 touch-manipulation';
          dot.dataset.index = String(page);
          dot.setAttribute('role', 'tab');
          dot.setAttribute('aria-label', `Ir a la página ${page + 1} de casos de éxito`);
          dot.setAttribute('aria-selected', page === 0 ? 'true' : 'false');
          dot.dataset.active = page === 0 ? 'true' : 'false';

          const innerDot = document.createElement('span');
          innerDot.className =
            'group-data-[active=true]:bg-cicagold-500 h-2 w-2 rounded-full bg-white/50 transition-all group-data-[active=true]:w-6 pointer-events-none block';
          dot.appendChild(innerDot);

          dot.addEventListener('click', () => {
            scrollToIndex(page);
            pauseThenResume();
          });
          dotsContainer.appendChild(dot);
          built.push(dot);
        }

        dots = built;
      }

      // Recalculado en cada resize: el breakpoint activo cambia cuántos
      // testimonios entran a la vez, así que tanto si "desborda" (hace
      // falta scroll) como la cantidad real de páginas pueden cambiar.
      function updateOverflow() {
        itemsPerView = measureItemsPerView();

        const nextTotalPages = Math.max(1, Math.ceil(realItems.length / itemsPerView));
        isOverflowing = nextTotalPages > 1;

        if (nextTotalPages !== totalPages || dots.length !== nextTotalPages) {
          totalPages = nextTotalPages;
          buildDots(totalPages);
        }

        if (isOverflowing) {
          setActive(nearestPage());
          start();
        } else {
          stop();
          if (resumeTimer) window.clearTimeout(resumeTimer);
        }
      }

      // Drag con Pointer Events (mouse + touch + pen, misma API) — ver
      // docblock de `initTestimonialsCarousels` más arriba. Mientras se
      // arrastra, `scrollLeft` se mueve 1:1 con el puntero (asignación
      // directa, instantánea — `scroll-behavior: smooth` de Tailwind NO
      // aplica a esto, solo a llamadas a `scrollTo()`); al soltar, se
      // suelta el drag y se hace un `scrollToIndex()` (ese sí animado) a
      // la página más cercana.
      let isDragging = false;
      let dragPointerId: number | undefined;
      let dragStartX = 0;
      let dragStartScrollLeft = 0;

      function onPointerDown(event: PointerEvent) {
        if (!isOverflowing) return;
        isDragging = true;
        dragPointerId = event.pointerId;
        dragStartX = event.clientX;
        dragStartScrollLeft = (track as HTMLElement).scrollLeft;
        (track as HTMLElement).classList.add('is-dragging');
        (track as HTMLElement).setPointerCapture(event.pointerId);
        stop();
      }

      function onPointerMove(event: PointerEvent) {
        if (!isDragging || event.pointerId !== dragPointerId) return;
        (track as HTMLElement).scrollLeft = dragStartScrollLeft - (event.clientX - dragStartX);
      }

      function onPointerUp(event: PointerEvent) {
        if (!isDragging || event.pointerId !== dragPointerId) return;
        isDragging = false;
        (track as HTMLElement).classList.remove('is-dragging');
        scrollToIndex(nearestPage());
        pauseThenResume();
      }

      track.addEventListener('pointerdown', onPointerDown);
      track.addEventListener('pointermove', onPointerMove);
      track.addEventListener('pointerup', onPointerUp);
      track.addEventListener('pointercancel', onPointerUp);
      track.addEventListener('scroll', pauseThenResume, { passive: true });
      track.addEventListener('scroll', handleScrollSettled, { passive: true });
      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);

      let resizeTimer: number | undefined;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(updateOverflow, 150);
      });

      updateOverflow();
    });
  }

  initTestimonialsCarousels();
  // Astro View Transitions no está en uso en este proyecto (ver
  // BaseLayout.astro), pero por si Antigravity lo suma más adelante, este
  // hook re-inicializa el carousel tras una navegación client-side.
  document.addEventListener('astro:page-load', initTestimonialsCarousels);
</script>
