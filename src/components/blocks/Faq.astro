---
/**
 * Stub funcional — usa <details>/<summary> nativos, sin JS (acordeón
 * accesible gratis del navegador). Antigravity: si el diseño final
 * necesita animación custom, evaluar si alcanza con CSS antes de sumar JS.
 */
import type { Block } from '../../lib/types';

interface FaqItem {
  question?: string;
  answer?: string;
}

interface Props {
  block: Block;
}

const { block } = Astro.props;
const content = block.content as { items?: FaqItem[] };
const items = content.items ?? [];
---

<section class="mx-auto max-w-3xl px-4 py-16">
  {block.title && <h2 class="mb-6 text-3xl font-bold">{block.title}</h2>}
  <div class="divide-y divide-gray-200">
    {
      items.map((item) => (
        <details class="py-4">
          <summary class="cursor-pointer font-medium">{item.question}</summary>
          <p class="mt-2 text-gray-600">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
